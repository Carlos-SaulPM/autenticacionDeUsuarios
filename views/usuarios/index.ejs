<%- include('../templates/head') %>

<main class="content">
  <div class="container-fluid p-0">
    <h1 class="h3 mb-3"><strong>Lista usuarios</strong></h1>

    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="card-title mb-0">Usuarios</h5>
          </div>
          <div class="card-body">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Primer Apellido</th>
                  <th>Segundo Apellido</th>
                  <th>Fecha de nacimiento</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% for( let index = 0; index < usuarios.lista.length; index++ )
                { %>
                <tr>
                  <td><%= usuarios.lista[index].nombre %></td>
                  <td><%= usuarios.lista[index].primerApellido %></td>
                  <td><%= usuarios.lista[index].segundoApellido %></td>
                  <td>
                    <%=
                    usuarios.lista[index].fechaDeNacimiento.toISOString().split('T')[0];
                    %>
                  </td>
                  <td>
                    <a
                      href="/usuarios/modificar/<%= usuarios.lista[index].id %>"
                      >📝</a
                    >
                  </td>
                  <td>
                    <a href="/usuarios/eliminar/<%= usuarios.lista[index].id %>"
                      >🗑</a
                    >
                  </td>
                </tr>
                <% } %>
              </tbody>
            </table>
            <br /><br />
            
            <div class="btn-group me-2" role="group" aria-label="First group">
              
              <a href="/usuarios/?pagina=1&limite=10"
                ><button type="button" class="btn btn-secondary">1</button></a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../templates/foot') %>
